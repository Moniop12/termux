<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/apk_builder_log_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#101010"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:id="@+id/apk_builder_log_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#1A1A1A">

        <ProgressBar
            android:id="@+id/apk_builder_log_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:indeterminateTint="#4CAF50" />

        <TextView
            android:id="@+id/apk_builder_log_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="@string/apk_builder_log_status_running" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/apk_builder_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <TextView
            android:id="@+id/apk_builder_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D0D0D0"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apk_builder_log_stop_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/apk_builder_log_stop_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apk_builder_log_close_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:enabled="false"
            android:text="@string/apk_builder_log_close_button" />
    </LinearLayout>

</LinearLayout>
